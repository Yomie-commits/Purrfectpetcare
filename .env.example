# ---------------------------------------------------------------
# Purrfect Pet Care configuration
# Copy this file to ".env" and fill in your values.
# NEVER share .env or upload it anywhere public.
# ---------------------------------------------------------------

# Full address of the site, no trailing slash (used in emails and payment callbacks)
APP_URL=https://yourdomain.com
APP_TIMEZONE=Africa/Nairobi
# Show detailed errors. Keep false on a live site.
APP_DEBUG=false

# --- Database -----------------------------------------------------
# mysql for cPanel hosting. (sqlite also works for a quick local trial.)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_petcare
DB_USER=cpaneluser_petcare
DB_PASS=change-me
# Only used when DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite

# --- Email (password resets, receipts, reminders) ---------------------
# Option 1 (works on free hosting): Brevo API key from brevo.com. Takes priority.
BREVO_API_KEY=
# Option 2: PHP mail(), which works on most paid cPanel hosts (not InfinityFree).
MAIL_ENABLED=false
# Sender address (for Brevo it must be a verified sender)
MAIL_FROM=no-reply@yourdomain.com

# --- SMS reminders (Africa's Talking) --------------------------------
# Leave empty to keep SMS off. AT_USERNAME=sandbox uses their free test environment.
AT_USERNAME=
AT_API_KEY=
# Optional approved sender name, e.g. PURRFECT
AT_SENDER_ID=

# --- M-Pesa (Safaricom Daraja STK Push) -------------------------------
# simulate = test mode, no money moves (default)
# sandbox  = Daraja sandbox with test credentials
# production = live payments (needs a Go-Live approved Daraja app)
MPESA_ENV=simulate
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill or Head Office shortcode. 174379 is the Daraja sandbox shortcode.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number - only needed for CustomerBuyGoodsOnline
MPESA_TILL_NUMBER=
# Must be a public HTTPS URL. Pick any long random string as the secret.
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa_callback.php?key=SAME-AS-MPESA_CALLBACK_SECRET

# --- Card payments (Paystack) -----------------------------------------
# Leave empty to run card payments in test (simulate) mode.
# Use sk_test_... for testing, sk_live_... for real payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
